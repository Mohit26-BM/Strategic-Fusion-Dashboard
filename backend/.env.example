# Copy to backend/.env for local development (git-ignored). On Render set the same names in the service's Environment tab.
# In development this file WINS over your computer's own environment variables; in production (NODE_ENV=production)
# real environment variables always win.

# ---- database -----------------------------------------------------------------------------------------------------
# Local MongoDB, or a MongoDB Atlas connection string. Required in production.
MONGO_URI=mongodb://localhost:27017
# Letters, digits, "_" and "-" only.
MONGO_DB=intel_db

# ---- who may change data ------------------------------------------------------------------------------------------
# REQUIRED to add, import, edit or delete. At least 16 characters. Without it the API is READ-ONLY (everyone can look).
# Generate one:  node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
ADMIN_TOKEN=

# The address(es) of the front end that may call this API from a browser, comma separated, no trailing slash.
# Development default: http://localhost:3000. In production nothing is allowed until you set it.
# Example: CORS_ORIGINS=https://strategic-fusion-dashboard.onrender.com
CORS_ORIGINS=http://localhost:3000

# ---- optional -----------------------------------------------------------------------------------------------------
# PORT=5000
# NODE_ENV=production
# TRUST_PROXY=1              how many proxies sit in front of the API (Render: 1, which is the default in production)
# GEOCODING=off              turn off the place-name lookups (OpenStreetMap Nominatim)
# GEOCODER_USER_AGENT=StrategicFusionDashboard/1.1 (you@example.com)   Nominatim asks for a way to contact you
