# Front end settings (Create React App). Copy to .env.development.local for local work (git-ignored).
# These are read when the app is BUILT, so on Render set them on the static site and trigger a new build.

# Where the API lives, including the /api part.
#   local development: leave it out (the default is http://localhost:5000/api)
#   on Render:         https://YOUR-API-SERVICE.onrender.com/api
# REACT_APP_API_URL=http://localhost:5000/api

# NOTE: this is public. Everything starting with REACT_APP_ ends up in the browser. Never put the admin token here.
